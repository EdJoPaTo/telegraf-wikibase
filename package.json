{
	"name": "telegraf-wikibase",
	"version": "0.13.0",
	"description": "Telegraf Middleware to use Wikibase entities (like Wikidata ones) in your users language",
	"keywords": [
		"grammy",
		"telegraf",
		"wikibase",
		"wikidata"
	],
	"license": "MIT",
	"author": {
		"name": "EdJoPaTo",
		"email": "telegraf-wikibase-npm-package@edjopato.de",
		"url": "https://edjopato.de"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EdJoPaTo/telegraf-wikibase.git"
	},
	"files": [
		"dist",
		"!*.test.*",
		"!test.*"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "rm -rf ./dist && tsc",
		"prepack": "npm run build",
		"test": "rm -rf ./dist && tsc --noEmit && oxlint && oxfmt --check && c8 --all node --enable-source-maps --test"
	},
	"dependencies": {
		"@edjopato/datastore": "^0.7.0",
		"array-filter-unique": "^3.0.2",
		"js-yaml": "^5.0.0",
		"tableize-object": "^0.1.0",
		"wikibase-sdk": "^11.6.6",
		"wikidata-entity-reader": "^5.0.0"
	},
	"devDependencies": {
		"@types/node": "^18.19.3",
		"c8": "^11.0.0",
		"grammy": "^1.2.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"telegraf": "^4.0.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=18"
	}
}
